{
  "name": "beetfit",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/fetch-mediapipe.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "deploy": "npm run build && wrangler deploy",
    "api:dev": "npm run build && wrangler dev --var ALLOW_UNSIGNED:1",
    "native:build": "VITE_API_URL=https://beetfit.wealthifai.xyz npm run build && cap sync",
    "native:permissions": "node scripts/native-permissions.mjs",
    "ios": "npm run native:build && cap open ios",
    "android": "npm run native:build && cap open android"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.5.3",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/ios": "8.5.3",
    "@capacitor/preferences": "8.0.1",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@fontsource-variable/unbounded": "5.3.0",
    "@mediapipe/tasks-vision": "1.1.1",
    "barcode-detector": "3.2.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zxing-wasm": "3.1.6"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^5.4.11",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "^3.2.7",
    "wrangler": "4.152.0"
  }
}
